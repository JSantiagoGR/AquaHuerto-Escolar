[TITLE]
Riego por goteo automatizado - 1 cajon (1.20 m x 0.80 m) - MODELO SIMPLIFICADO
4 laterales x 6 goteros x 4 L/h = 96 L/h = 1.60 L/min = 0.0266667 L/s. Escenario: RIEGO ACTIVO (V1 OPEN, bomba ON)
PRELIMINAR: curva de bomba PROVISIONAL, elevaciones=0 (datum), diametros nominales. Ver calculos_hidraulicos.md
COPIA DE PRESENTACION: solo cambian coordenadas, vertices y etiquetas; red hidraulica identica a riego_huerto_final.inp

[JUNCTIONS]
;ID              	Elev (m)	Demand (L/s)	Pattern
; Elev = 0 m es un DATUM PROVISIONAL comun. NO son elevaciones fisicas medidas.
 J-PUMP          	0       	0           	;Descarga de la bomba
 J-FLOW          	0       	0           	;Ubicacion fisica del caudalimetro YF-S201 (1/2 in). Perdida propia NO caracterizada (=0)
 J-HEAD-IN       	0       	0           	;Salida de electrovalvula / entrada al cabezal 16 mm
 J-H             	0       	0           	;Nodo de distribucion del cabezal hacia los 4 laterales
 L1              	0       	0.00666667  	;Lateral 1: 6 goteros x 4 L/h = 24 L/h = 0.40 L/min
 L2              	0       	0.00666667  	;Lateral 2: 6 goteros x 4 L/h = 24 L/h = 0.40 L/min
 L3              	0       	0.00666667  	;Lateral 3: 6 goteros x 4 L/h = 24 L/h = 0.40 L/min
 L4              	0       	0.00666667  	;Lateral 4: 6 goteros x 4 L/h = 24 L/h = 0.40 L/min

[RESERVOIRS]
;ID              	Head (m)	Pattern
; Head = 0 m es SOLO un datum provisional. ESTO NO SIGNIFICA QUE EL NIVEL REAL DEL TINACO SEA 0 m.
 R1              	0       	        	;TINACO

[TANKS]
;ID              	Elevation	InitLevel	MinLevel	MaxLevel	Diameter	MinVol	VolCurve	Overflow

[PIPES]
;ID              	Node1           	Node2           	Length (m)	Diam (mm)	Roughness	MinorLoss	Status
; Diametros = NOMINALES usados como APROXIMACION PROVISIONAL (no son diametros interiores medidos).
; Roughness = C de Hazen-Williams = 140 (modelo base). Sensibilidad C=150 en calculos_hidraulicos.md
 P-MAIN          	J-PUMP          	J-FLOW          	1.5       	12.7     	140      	0        	Open  	;Tramo principal 1/2 in
; V1 = ELECTROVALVULA NC 12 V DC 1/2 in, representada como enlace de cierre ON/OFF (Pipe con Status).
;   RIEGO ACTIVO -> Open ; reposo -> Closed. Longitud 0.01 m = valor NUMERICO (no fisico) para que su
;   friccion sea despreciable (~7e-5 m). MinorLoss = 0: la perdida real (Cv/Kv/K) esta PENDIENTE, NO se inventa.
;   (Una TCV con K=0 se probo primero y produjo desbalance numerico de continuidad; ver validacion_epanet.txt)
 V1              	J-FLOW          	J-HEAD-IN       	0.01      	12.7     	140      	0        	Open  	;ELECTROVALVULA NC (OPEN en riego)
 P-HEADER        	J-HEAD-IN       	J-H             	0.8       	16       	140      	0        	Open  	;Cabezal PE 16 mm
 PL1             	J-H             	L1              	1.2       	16       	140      	0        	Open  	;Lateral 1 (16 mm)
 PL2             	J-H             	L2              	1.2       	16       	140      	0        	Open  	;Lateral 2 (16 mm)
 PL3             	J-H             	L3              	1.2       	16       	140      	0        	Open  	;Lateral 3 (16 mm)
 PL4             	J-H             	L4              	1.2       	16       	140      	0        	Open  	;Lateral 4 (16 mm)

[PUMPS]
;ID              	Node1           	Node2           	Parameters
 PU1             	R1              	J-PUMP          	HEAD PUMP_CURVE_PROVISIONAL	;Bomba diafragma 12 V GOOD PUMPS (curva NO certificada)

[VALVES]
;ID              	Node1           	Node2           	Diam (mm)	Type	Setting	MinorLoss
; Sin valvulas de control EPANET: la electrovalvula V1 esta en [PIPES] como enlace ON/OFF (ver nota alli).
; Cuando se conozca su Cv/Kv, podra sustituirse por una TCV con Setting = K real.

