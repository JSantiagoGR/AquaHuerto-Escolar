    "type": "mqtt in",
    "z": "tab_riego",
    "name": "telemetry",
    "topic": "huerto/esp32/telemetry",
    "qos": "0",
    "datatype": "json",
    "broker": "broker_huerto",
    "nl": false,
    "rap": true,
    "rh": 0,
