  {
    "id": "f_state",
    "type": "function",
    "z": "tab_riego",
    "name": "Separar estado",
    "func": "const s = msg.payload;\nconst w = s.watering || {}; const e = s.event || {};\nflow.set('state', s);\nreturn [\n  { payload: s.pump ? 'ENCENDIDA' : 'APAGADA' },\n  { payload: s.valve ? 'ABIERTA' : 'CERRADA' },\n  { payload: s.state + (s.phase && s.phase !== 'NONE' ? ' / ' + s.phase : '') },\n  { payload: (s.mqtt ? 'MQTT OK' : 'MQTT —') + ' | Wi-Fi ' + (s.wifi ? 'OK' : '—') + ' | RSSI ' + s.rssi },\n  { payload: w.active ? (w.delivered_l + ' / ' + w.target_l + ' L (' + w.progress_pct + ' %) ' + w.elapsed_s + ' s') : 'Sin riego' },\n  { payload: w.active ? w.progress_pct : 0 },\n  { payload: s.auto_enabled },\n  { payload: s.decision ? s.decision.code + ': ' + s.decision.text : '-' },\n  { payload: 'Próximo horario: ' + s.next_window + (s.time_valid ? '' : ' (SIN HORA)') },\n  { payload: 'Ciclos: ' + e.cycles + ' | ' + e.liters + ' L' + (e.infiltration_remaining_s ? ' | infiltración ' + e.infiltration_remaining_s + ' s' : '') },\n  { payload: (s.alarms && s.alarms.length) ? s.alarms.join(', ') : 'Sin alarmas' },\n  { payload: 'Modo ' + s.mode + ' | Potencia ' + (s.power_outputs ? 'HABILITADA' : 'DESHABILITADA') + (s.simulation ? ' | SIMULACIÓN' : '') }\n];",
    "outputs": 12,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 560,
    "wires": [
      [
        "t_pump"
      ],
      [
        "t_valve"
      ],
      [
        "t_state"
      ],
      [
        "t_comms"
      ],
