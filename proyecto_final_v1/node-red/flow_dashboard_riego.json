    "type": "function",
    "z": "tab_riego",
    "name": "Añadir id y ts",
    "func": "const now = Date.now();\nmsg.payload = Object.assign({ id: 'nr-' + now + '-' + Math.floor(Math.random()*1000), ts: Math.floor(now/1000) }, msg.payload);\nreturn msg;",
