  {
    "id": "f_event",
    "type": "function",
    "z": "tab_riego",
    "name": "Agregar al historial",
    "func": "// Historial local (contexto de flujo; ver la guía para guardarlo en disco)\nconst e = msg.payload;\nif (e.type !== 'WATERING_END' && e.type !== 'AUTO_EVENT_END') return null;\nconst h = flow.get('historial') || [];\nconst fecha = e.ts ? new Date(e.ts * 1000).toLocaleString('es-MX') : 'sin hora';\nh.unshift({\n  Fecha: fecha,\n  Tipo: e.type === 'WATERING_END' ? 'Riego ' + e.reason : 'Evento automático',\n  Resultado: e.result || e.why,\n  Litros: e.delivered_l !== undefined ? e.delivered_l : e.liters,\n  'Duración s': e.duration_s,\n  'Humedad antes': e.vwc_before,\n  'Humedad después': e.vwc_after\n});\nflow.set('historial', h.slice(0, 50));\nmsg.payload = h.slice(0, 50);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 1760,
    "wires": [
      [
        "tb_hist"
      ]
    ]
  },
