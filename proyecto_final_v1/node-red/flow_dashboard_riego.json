  {
    "id": "f_tel",
    "type": "function",
    "z": "tab_riego",
    "name": "Separar telemetría",
    "func": "const t = msg.payload;\nconst ts = Date.now();\nfunction m(v, topic) { return (v === null || v === undefined) ? null : { payload: v, topic: topic, timestamp: ts }; }\nreturn [\n  m(t.soil && t.soil.valid ? t.soil.vwc_pct : null, 'Humedad suelo %VWC'),\n  m(t.tank && t.tank.level_pct !== null ? t.tank.level_pct : null, 'Tinaco %'),\n  m(t.env && t.env.valid ? t.env.temp_c : null, 'Temperatura C'),\n  m(t.env && t.env.valid ? t.env.rh_pct : null, 'HR ambiente %'),\n  m(t.flow ? t.flow.lpm : null, 'Caudal L/min'),\n  m(t.flow ? t.flow.today_l : null, 'Litros hoy'),\n  { payload: (t.soil ? t.soil.status : '-') + ' | ' + (t.soil ? t.soil.mv + ' mV' : '') },\n  { payload: (t.tank ? t.tank.status : '-') + ' | ' + (t.tank && t.tank.distance_cm !== null ? t.tank.distance_cm + ' cm' : 'sin eco') },\n  { payload: t.simulation ? 'SIMULACIÓN (salidas inactivas)' : 'Sensores reales' }\n];",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 440,
    "y": 60,
    "wires": [
      [
        "g_soil",
        "c_soil"
      ],
      [
        "g_tank",
        "c_tank"
      ],
      [
        "g_temp",
        "c_temp"
      ],
      [
        "g_rh",
        "c_rh"
