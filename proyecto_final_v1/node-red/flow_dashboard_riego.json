  {
    "id": "f_hum",
    "type": "function",
    "z": "tab_riego",
    "name": "Rango de humedad",
    "func": "// Guarda el valor del slider y envía SET_HUMIDITY_RANGE con los tres valores\nconst p = flow.get('cfg') || {};\nconst h = flow.get('hum') || { min: p.hum_min, target: p.hum_target, max: p.hum_max };\nh[msg.topic] = Number(msg.payload);\nflow.set('hum', h);\nif (!(h.min < h.target && h.target < h.max)) {\n  node.warn('No se envía: debe cumplirse MÍNIMA < OBJETIVO < MÁXIMA');\n  return [null, { payload: 'Revise: MÍNIMA < OBJETIVO < MÁXIMA' }];\n}\nreturn [{ payload: { cmd: 'SET_HUMIDITY_RANGE', min: h.min, target: h.target, max: h.max } }, null];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1220,
    "y": 910,
    "wires": [
