{
  "_info": "Ejemplos compatibles con el firmware Proyecto_Final_v1. Topic base: huerto/esp32. Los comandos se publican en huerto/esp32/command con retain=false y QoS 1. 'id' debe ser unico por comando. 'ts' (segundos Unix) es opcional; si se envia y el ESP32 tiene hora valida, se rechaza si difiere mas de 60 s. 'token' solo si se configuro CONFIG_RIEGO_CMD_TOKEN.",
  "comandos": [
    {"descripcion": "Pedir estado, telemetria y decision", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0001", "cmd": "GET_STATUS"}},
    {"descripcion": "Pedir configuracion (se publica en huerto/esp32/config)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0002", "cmd": "GET_CONFIG"}},
    {"descripcion": "Pedir historial de riegos (huerto/esp32/history)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0003", "cmd": "GET_HISTORY"}},
    {"descripcion": "Riego manual de 1 litro", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0004", "cmd": "START_MANUAL", "liters": 1.0, "ts": 1791800000}},
    {"descripcion": "Riego manual de 0.5 L forzado aunque el suelo este sobre el maximo", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0005", "cmd": "START_MANUAL", "liters": 0.5, "force": true}},
    {"descripcion": "Detener inmediatamente (siempre se ejecuta)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0006", "cmd": "STOP"}},
    {"descripcion": "Habilitar riego automatico", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0007", "cmd": "ENABLE_AUTO"}},
    {"descripcion": "Deshabilitar riego automatico", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0008", "cmd": "DISABLE_AUTO"}},
    {"descripcion": "Humedad minima (%VWC)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0009", "cmd": "SET_HUMIDITY_MIN", "value": 25}},
    {"descripcion": "Humedad recomendada / objetivo (%VWC)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0010", "cmd": "SET_HUMIDITY_TARGET", "value": 35}},
    {"descripcion": "Humedad maxima (%VWC)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0011", "cmd": "SET_HUMIDITY_MAX", "value": 45}},
    {"descripcion": "Los tres umbrales a la vez (recomendado al cambiar de cultivo)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0012", "cmd": "SET_HUMIDITY_RANGE", "min": 25, "target": 35, "max": 45}},
    {"descripcion": "Litros por ciclo automatico", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0013", "cmd": "SET_LITERS_PER_CYCLE", "value": 1.0}},
    {"descripcion": "Espera de infiltracion (minutos)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0014", "cmd": "SET_INFILT_WAIT", "value": 15}},
    {"descripcion": "Maximos de litros por evento y por dia", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0015", "cmd": "SET_MAX_LITERS", "event": 3.0, "daily": 10.0}},
    {"descripcion": "Calibracion del YF-S201 con pulsos/L directo", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0016", "cmd": "SET_FLOW_CALIBRATION", "pulses_per_liter": 450}},
    {"descripcion": "Calibracion del YF-S201 con medicion en recipiente", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0017", "cmd": "SET_FLOW_CALIBRATION", "pulses": 930, "measured_ml": 2000}},
    {"descripcion": "Nivel minimo de seguridad del tinaco (%)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0018", "cmd": "SET_TANK_MIN_LEVEL", "value": 20}},
    {"descripcion": "Calibrar tinaco: distancia del sensor al agua con tinaco vacio y lleno", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0019", "cmd": "SET_TANK_CALIBRATION", "empty_cm": 120.0, "full_cm": 20.0}},
    {"descripcion": "Horario 1 de 06:00 a 09:00", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0020", "cmd": "SET_SCHEDULE", "window": 1, "enabled": true, "start": "06:00", "end": "09:00"}},
    {"descripcion": "Horario 2 de 18:00 a 20:00", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0021", "cmd": "SET_SCHEDULE", "window": 2, "enabled": true, "start": "18:00", "end": "20:00"}},
    {"descripcion": "Parametro generico (cualquier clave remota de GET_CONFIG)", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0022", "cmd": "SET_CONFIG", "key": "temp_postpone_c", "value": 34}},
    {"descripcion": "Humedad critica para emergencia", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0023", "cmd": "SET_CONFIG", "key": "hum_critical", "value": 18}},
    {"descripcion": "Desactivar emergencias", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0024", "cmd": "SET_CONFIG", "key": "emergency_en", "value": false}},
    {"descripcion": "Borrar todas las alarmas resueltas", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0025", "cmd": "CLEAR_ALARM", "alarm": "ALL"}},
    {"descripcion": "Borrar una alarma concreta", "topic": "huerto/esp32/command",
     "payload": {"id": "nr-0026", "cmd": "CLEAR_ALARM", "alarm": "NO_FLOW"}}
  ],
