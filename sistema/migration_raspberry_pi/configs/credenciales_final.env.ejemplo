# PLANTILLA de credenciales del ENTORNO FINAL (Raspberry Pi).
# Copiar a configs/secrets/credenciales_final.env y reemplazar TODOS los valores.
# Generar contraseñas nuevas (no reutilizar las de casa):  openssl rand -base64 18
MQTT_ESP32_USER=esp32_principal
MQTT_ESP32_PASS=CAMBIAR
MQTT_NODERED_USER=nodered_final
MQTT_NODERED_PASS=CAMBIAR
MQTT_SIM_USER=simulador_final
MQTT_SIM_PASS=CAMBIAR
MQTT_ADMIN_USER=admin_final
MQTT_ADMIN_PASS=CAMBIAR
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASS=CAMBIAR
DASHBOARD_USER=huerto
DASHBOARD_PASS=CAMBIAR
NODERED_CREDENTIAL_SECRET=CAMBIAR_POR_TEXTO_LARGO_ALEATORIO
# Rutas y entorno (no secretos)
RIEGO_ENV=final
RIEGO_TOPIC_ROOT=huerto/final
MQTT_HOST=127.0.0.1
MQTT_PORT=1884
